{
  "name": "portfolio",
  "version": "1.0.0",
  "description": "Portfolio",
  "scripts": {
    "reset": "node -e \"for (const p of ['dist', 'dist-dev', 'node_modules', 'package-lock.json']) require('fs').rmSync(p, { recursive: true, force: true })\" && npm i",
    "build": "cross-env NODE_ENV=production webpack --config ./webpack.config.js",
    "build-dev": "cross-env NODE_ENV=development webpack --config ./webpack.config.js",
    "dev": "cross-env NODE_ENV=development nodemon --watch ./src  --delay 2500ms ./bin/dev.js -e js,css",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/valentinMachado/valentinMachado.github.io.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/valentinMachado/valentinMachado.github.io/issues"
  },
  "homepage": "https://github.com/valentinMachado/valentinMachado.github.io#readme",
  "dependencies": {
    "three": "^0.168.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "express": "^4.22.3",
    "jsdom": "^30.1.1",
    "nodemon": "^3.1.14",
    "three-inspect": "^0.7.2",
    "vitest": "^5.0.2",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.1.4"
  },
  "private": true
}
